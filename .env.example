GITLAB_URL=https://gitlab.company.com
GITLAB_TOKEN=glpat-xxx
JIRA_URL=https://jira.company.com
JIRA_LOGIN=user
JIRA_PASSWORD=xxx
LLM_TIMEOUT=120
LLM_TIME_BUDGET=1800
LLM_OVERLOADED_QUARANTINE=120
LLM_HTTP_PROXY=
LLM_GENERATE_PROVIDER=gemini
LLM_GENERATE_MODEL=gemini-3.7-flash
LLM_GENERATE_FALLBACK_MODEL=gemini-3.8-flash
LLM_GENERATE_TEMPERATURE=0.1
LLM_CRITIQUE_PROVIDER=ollama
LLM_CRITIQUE_MODEL=qwen2.5-coder:7b
LLM_CRITIQUE_FALLBACK_MODEL=gemini/gemini-3.7-flash
LLM_CRITIQUE_TEMPERATURE=0
OLLAMA_API_BASE=http://localhost:11434/v1
GEMINI_API_KEY=xxx
GEMINI_API_KEYS=xxx,yyy
# Other providers of a mixed pool (see README, "A pool of models from several providers")
# OPENAI_API_KEY=xxx
# ANTHROPIC_API_KEY=xxx
# OPENROUTER_API_KEY=xxx
REVIEW_LANGUAGE=ru
REVIEW_MODE=update
# A shared pool instead of per-stage chains (see README, "Shared model pool")
# LLM_MODELS=gemini/gemini-3.8-flash,gemini/gemini-3.7-flash,gemini/gemini-3.6-flash
# LLM_GENERATE_START=gemini-3.7-flash
# LLM_CRITIQUE_RANK=not_below_generate
# LLM_CRITIQUE_ALLOW_WEAKER=false
# Jev as the critique engine or next to it, log only (see README, "Critique engine")
# LLM_CRITIQUE_ENGINE=jev
# LLM_JEV_FALLBACK=model
# LLM_JEV_KEEP_ABOVE=0.5
# LLM_JEV_SHADOW=true
# LLM_JEV_MODEL=jev-1.13.0
# JEV_API_KEY=xxx

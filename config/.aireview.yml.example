ignore_paths:
  - db/migrate/**
  - vendor/**
  - node_modules/**
  - "*.lock"

secret_patterns:
  - 'api_key\s*=\s*["'\''].*["'\'']'
  - 'SECRET_[A-Z_]+'

# update — обновлять свой комментарий, когда дифф или настройки изменились,
# once — один раз автоматически; Retry джоба обновляет ревью при изменениях.
review_mode: update

secret_files:
  - .env
  - .env.*
  - config/secrets.yml
  - config/credentials/*.key

review_instructions: |
  Это Rails-проект. Обращай внимание на:
  - N+1 запросы
  - strong params
  - отсутствие тестов для новой логики
  Игнорируй стилистику — для этого есть линтеры.

llm:
  provider: gemini
  temperature: 0.2
  generate:
    model: gemini-3.7-flash
    fallbacks:
      - gemini-3.8-flash
  critique:
    model: gemini-3.8-flash
    fallbacks:
      - gemini-3.7-flash
